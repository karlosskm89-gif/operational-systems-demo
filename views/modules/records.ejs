<section class="section">
  <div class="container">
    <p class="breadcrumb"><a href="/modules">← Back to modules</a></p>

    <div class="section-heading">
      <p class="eyebrow">Operational history</p>
      <h1>Records Module</h1>
      <p class="lead">
        Fictional records show how context from different kinds of accepted work can carry forward into an operational history rather than disappearing into an inbox.
      </p>
    </div>

    <div class="table-card table-scroll">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Type</th>
            <th>Source request</th>
            <th>Status</th>
            <th>Updated</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% records.forEach((record) => { %>
            <tr>
              <td><%= record.id %></td>
              <td><%= record.name %></td>
              <td><%= record.type %></td>
              <td><%= record.sourceBookingId || '—' %></td>
              <td><span class="status-badge"><%= record.status %></span></td>
              <td><%= record.lastUpdated %></td>
              <td><a href="/modules/records/<%= record.id %>">View</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</section>
