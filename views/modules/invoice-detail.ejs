<section class="section">
  <div class="container narrow">
    <p class="breadcrumb"><a href="/modules/invoices">← Back to invoices</a></p>

    <article class="detail-card">
      <p class="eyebrow">Demo invoice</p>
      <h1><%= invoice.id %></h1>

      <dl class="detail-list">
        <div><dt>Client / account</dt><dd><%= invoice.client %></dd></div>
        <div><dt>Service / use</dt><dd><%= invoice.service %></dd></div>
        <div><dt>Amount</dt><dd>€<%= invoice.amount %></dd></div>
        <div><dt>Status</dt><dd><%= invoice.status %></dd></div>
        <div><dt>Source record</dt><dd><%= invoice.sourceRecordId || 'Not linked in sample data' %></dd></div>
        <div><dt>Issued</dt><dd><%= invoice.issued %></dd></div>
        <div><dt>Due</dt><dd><%= invoice.due %></dd></div>
      </dl>

      <% if (invoice.sourceRecordId) { %>
        <div class="actions">
          <a class="btn btn-secondary" href="/modules/records/<%= invoice.sourceRecordId %>">View source record</a>
        </div>
      <% } %>

      <p class="helper-note">
        Demo only. Financial workflow is shown as an optional downstream layer rather than an assumed part of every booking process.
      </p>
    </article>
  </div>
</section>
