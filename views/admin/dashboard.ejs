<section class="section">
  <div class="container">
    <div class="admin-header">
      <div>
        <p class="eyebrow">Admin side</p>
        <h1>Shared booking & enquiry queue</h1>
        <p class="lead">Review appointment, venue, group and recurring requests in one place, then filter, update state and export the workflow data.</p>
        <p class="demo-notice">Public demo admin — no login required and no real client data. Changes affect sample data only and can be reset.</p>
      </div>
      <div class="admin-actions">
        <a class="btn btn-secondary" href="/book">Create sample request</a>
        <a class="btn btn-secondary" href="/admin/export.csv">Export CSV</a>
        <form method="post" action="/admin/reset-demo" class="reset-demo-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-secondary" type="submit">Reset demo data</button>
        </form>
      </div>
    </div>

    <div class="stats-grid">
      <div class="stat"><strong><%= stats.total %></strong><span>Total requests</span></div>
      <div class="stat"><strong><%= stats.newCount %></strong><span>New</span></div>
      <div class="stat"><strong><%= stats.confirmedCount %></strong><span>Confirmed</span></div>
      <div class="stat"><strong><%= stats.actionCount %></strong><span>Need action</span></div>
    </div>

    <div class="filter-panel">
      <div>
        <span class="filter-label">Status</span>
        <div class="filter-bar">
          <% ["All", ...statuses].forEach((item) => { %>
            <% const href = '/admin?' + new URLSearchParams({ ...(item !== 'All' ? { status: item } : {}), ...(type !== 'All' ? { type } : {}) }).toString(); %>
            <a class="<%= status === item ? 'active' : '' %>" href="<%= href === '/admin?' ? '/admin' : href %>"><%= item %></a>
          <% }); %>
        </div>
      </div>
      <div>
        <span class="filter-label">Request type</span>
        <div class="filter-bar">
          <% [{ value: 'All', shortLabel: 'All types' }, ...bookingTypes].forEach((item) => { %>
            <% const value = item.value; %>
            <% const href = '/admin?' + new URLSearchParams({ ...(status !== 'All' ? { status } : {}), ...(value !== 'All' ? { type: value } : {}) }).toString(); %>
            <a class="<%= type === value ? 'active' : '' %>" href="<%= href === '/admin?' ? '/admin' : href %>"><%= item.shortLabel %></a>
          <% }); %>
        </div>
      </div>
    </div>

    <div class="table-card table-scroll">
      <table>
        <thead>
          <tr><th>ID</th><th>Type</th><th>Contact</th><th>Request</th><th>Schedule</th><th>Review</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
          <% if (!bookings.length) { %>
            <tr><td colspan="8">No sample requests match these filters.</td></tr>
          <% } %>
          <% bookings.forEach((booking) => { %>
            <tr>
              <td><%= booking.id %></td>
              <td><span class="type-badge"><%= booking.typeLabel %></span></td>
              <td><strong><%= booking.name %></strong><br><span class="table-muted"><%= booking.email %></span></td>
              <td><%= booking.subject %></td>
              <td><%= booking.schedule %></td>
              <td><span class="status <%= booking.conflictIds.length ? 'status-warning' : '' %>"><%= booking.availabilityStatus %></span></td>
              <td><span class="status"><%= booking.status %></span></td>
              <td><a href="/admin/bookings/<%= booking.id %>">Open</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</section>
