<section class="section booking-intake-section">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Public intake</p>
      <h1>What would you like to arrange?</h1>
      <p class="lead">
        This demo shows how different kinds of bookings and enquiries can enter one shared operational workflow.
        Choose a pattern below, submit a fictional request, then follow it into the admin side.
      </p>
    </div>

    <div class="booking-type-grid">
      <% bookingTypes.forEach((type) => { %>
        <article class="booking-type-card">
          <span class="booking-type-kicker"><%= type.shortLabel %></span>
          <h2><%= type.label %></h2>
          <p><%= type.summary %></p>
          <p class="booking-type-fit"><strong>Useful for:</strong> <%= type.bestFor %></p>
          <a class="btn" href="/book?type=<%= encodeURIComponent(type.value) %>">Try this flow</a>
        </article>
      <% }); %>
    </div>

    <div class="workflow-callout booking-shared-callout">
      <div>
        <p class="eyebrow">One operational layer</p>
        <h2>Different inputs. One manageable queue.</h2>
        <p>
          These are not four separate products. Each public flow becomes a structured request inside the same admin system,
          where staff can review context, spot clashes, update status and export data.
        </p>
      </div>
      <div class="actions">
        <a class="btn btn-secondary" href="/admin">Open shared admin</a>
        <a class="btn btn-secondary" href="/workflow">See the workflow</a>
      </div>
    </div>
  </div>
</section>
